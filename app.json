{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.orbit.family",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Orbit shares your location with the circles you choose, only while sharing is on.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Orbit shares your location with your circles in the background so they can see you're safe. You can pause or turn this off any time.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "app.orbit.family",
      "adaptiveIcon": {
        "backgroundColor": "#5B7CFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Orbit",
      "shortName": "Orbit",
      "themeColor": "#5B7CFA",
      "backgroundColor": "#0B0D12"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B7CFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B7CFA"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@maplibre/maplibre-react-native",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Circle",
              "label": "Orbit circle",
              "description": "Where everyone is",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/orbit"
    }
  }
}
